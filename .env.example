# Copy this file to `.env` and fill in your local values.
# Note: Spring Boot does not automatically read a .env file.
# Use your IDE Run/Debug configuration, Docker Compose, or your shell to export these variables.

# Server
SERVER_PORT=8080

# Database
# For PostgreSQL (example): jdbc:postgresql://localhost:5432/employee_db
# For MySQL (example):     jdbc:mysql://localhost:3306/employee_db
DB_URL=jdbc:postgresql://localhost:5432/employee_capstone
DB_USERNAME=postgres
DB_PASSWORD=umutoni078

# JWT
# Generate a strong secret (at least 32+ random characters)
JWT_SECRET=change_me_to_a_strong_secret_value
# Token expiration in milliseconds (default 1 hour)
JWT_EXPIRATION_MS=3600000

# Optional: Spring profile
# SPRING_PROFILES_ACTIVE=dev
